  <!-- JS for Dynamic background color shift, section active states and scroll-reveal animations -->
  <script>
    const dynamicBg = document.getElementById('dynamic-bg');
    const sections = document.querySelectorAll('section[id]');
    const scrollRevealElements = document.querySelectorAll('.scroll-reveal');

    const bgMap = {
      openai: 'bg-[#04120e]',       // Deep forest emerald green
      google: 'bg-[#050f24]',       // Deep tech space blue
      anthropic: 'bg-[#140b06]',    // Deep warm copper clay
      compromiso: 'bg-[#0e0712]',   // Deep Carmay purple
      'como-funciona': 'bg-[#090b11]'
    };

    const observerOptions = {
      root: null,
      rootMargin: '-30% 0px -40% 0px', // Actives when section hits the center of screen
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          
          // Toggle active-section class for themed styling (glow + watermark highlight)
          sections.forEach(s => s.classList.remove('active-section'));
          entry.target.classList.add('active-section');

          if (bgMap[id]) {
            dynamicBg.className = 'fixed inset-0 -z-20 bg-transition ' + bgMap[id];
          } else {
            dynamicBg.className = 'fixed inset-0 -z-20 bg-transition bg-[#090b11]';
          }
        }
      });
    }, observerOptions);

    sections.forEach(section => observer.observe(section));

    // Scroll reveal logic (entry and exit upwards transitions)
    function checkScroll() {
      const viewportHeight = window.innerHeight;
      scrollRevealElements.forEach(el => {
        const rect = el.getBoundingClientRect();
        
        // Element is scrolled past the top (exit upwards)
        if (rect.bottom < 120) {
          el.classList.remove('visible');
          el.classList.add('scrolled-up');
        } 
        // Element is visible in the viewport
        else if (rect.top <= viewportHeight - 65) {
          el.classList.add('visible');
          el.classList.remove('scrolled-up');
        } 
        // Element is below the viewport
        else {
          el.classList.remove('visible', 'scrolled-up');
        }
      });
    }

    // Bind scroll listeners
    window.addEventListener('scroll', checkScroll, { passive: true });
    window.addEventListener('resize', checkScroll, { passive: true });
    
    // Initial runs to trigger visible states on load
    checkScroll();
    setTimeout(checkScroll, 100);
    setTimeout(checkScroll, 400);
  </script>
</Layout>
