---
import Layout from '../layouts/Layout.astro';
import config from '../data/planes.json';

// WhatsApp contact number (international format without +)
const WHATSAPP_NUMBER = "5359253999";

const TASA_CAMBIO = config.tasaCambio;
const planes = config.planes.map(p => ({
  ...p,
  finalPriceCUP: p.finalPriceUSD * TASA_CAMBIO
}));

// Grouping plans by provider
const openaiPlanes = planes.filter(p => p.provider === 'OpenAI');
const googlePlanes = planes.filter(p => p.provider === 'Google');
const anthropicPlanes = planes.filter(p => p.provider === 'Anthropic');
const opencodePlanes = planes.filter(p => p.provider === 'OpenCode');

// Consistency helper for CUP formatting (Spanish standard thousands separator)
const formatCUP = (price) => {
  return price.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
};
---

<Layout>
  <!-- Fixed Dynamic Background with transition -->
  <div id="dynamic-bg" class="fixed inset-0 -z-20 bg-transition bg-[#090b11]"></div>
  
  <!-- Subtle ambient grid overlay -->
  <div class="fixed inset-0 -z-10 bg-[linear-gradient(to_right,rgba(255,255,255,0.01)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.01)_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none opacity-40"></div>

  <!-- Header / Nav -->
  <header class="border-b border-white/10 backdrop-blur-md bg-[#0b0f19]/60 sticky top-0 z-50 transition-all duration-300">
    <!-- Reading Scroll Progress Bar -->
    <div id="scroll-progress" class="absolute top-0 left-0 h-[2.5px] bg-gradient-to-r from-purple-500 via-[#6d1e68] to-emerald-400 w-0 transition-all duration-75 z-50"></div>

    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center relative">
      <!-- Logo Top-Left -->
      <div class="flex items-center gap-3">
        <img src="/logo-en-blanco.png" alt="Carmay Logo" class="h-24 md:h-28 -my-6 md:-my-8 w-auto object-contain shadow-md shadow-[#6d1e68]/5" />
      </div>
      
      <nav class="hidden md:flex items-center gap-6 lg:gap-8 text-sm font-semibold text-slate-300">
        <a href="#openai" id="nav-link-openai" class="nav-link-glow hover:text-emerald-400 transition-colors">ChatGPT</a>
        <a href="#google" id="nav-link-google" class="nav-link-glow hover:text-blue-400 transition-colors">Gemini</a>
        <a href="#anthropic" id="nav-link-anthropic" class="nav-link-glow hover:text-orange-400 transition-colors">Claude</a>
        <a href="#opencode" id="nav-link-opencode" class="nav-link-glow hover:text-indigo-400 transition-colors">OpenCode</a>
        <a href="#compromiso" id="nav-link-compromiso" class="nav-link-glow hover:text-amber-400 transition-colors">Nuestro Compromiso</a>
        <a href="#contacto" id="nav-link-contacto" class="nav-link-glow hover:text-purple-400 transition-colors">Contacto</a>
      </nav>

      <!-- Actions container -->
      <div class="flex items-center gap-3">
        <!-- Golden Advice Button (Responsive layout) -->
        <a 
          href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola! No estoy seguro de qué plan de IA se adapta mejor a mis necesidades. ¿Podrían ayudarme a elegir el ideal para mi caso?')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex px-5 py-2.5 rounded-full bg-gradient-to-r from-amber-400 via-yellow-500 to-amber-600 hover:from-amber-500 hover:to-yellow-600 text-slate-950 text-xs font-bold tracking-wide transition-all shadow-md shadow-amber-500/20 hover:scale-105 active:scale-95 items-center gap-2 border border-yellow-300/30"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 113.536 0V21h2v-2.243a5.002 5.002 0 01-3.536 0z" />
          </svg>
          Consulta qué plan es mejor para ti
        </a>

        <!-- Mobile Menu Button -->
        <button 
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-xl bg-white/5 border border-white/10 text-slate-300 hover:text-white transition-all duration-200 cursor-pointer"
          aria-label="Menú de navegación"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Navigation Overlay & Drawer -->
  <div id="mobile-menu-overlay" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 opacity-0 pointer-events-none transition-all duration-300"></div>
  <div 
    id="mobile-menu-drawer"
    class="fixed right-0 top-0 bottom-0 w-[300px] bg-[#0b0f19]/98 backdrop-blur-xl border-l border-white/10 z-50 translate-x-full transition-transform duration-300 ease-out flex flex-col p-8 gap-8"
  >
    <!-- Drawer Header -->
    <div class="flex justify-between items-center pb-6 border-b border-white/5">
      <span class="text-lg font-black text-white font-display">Navegación</span>
      <button 
        id="mobile-menu-close"
        class="p-2 rounded-xl bg-white/5 border border-white/10 text-slate-300 hover:text-white cursor-pointer"
        aria-label="Cerrar menú"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Links -->
    <nav class="flex flex-col gap-6 text-lg font-bold text-slate-300 font-sans">
      <a href="#openai" class="hover:text-emerald-400 transition-colors py-2 border-b border-white/5 flex items-center justify-between">
        ChatGPT <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      </a>
      <a href="#google" class="hover:text-blue-400 transition-colors py-2 border-b border-white/5 flex items-center justify-between">
        Gemini <span class="w-2 h-2 rounded-full bg-blue-400"></span>
      </a>
      <a href="#anthropic" class="hover:text-orange-400 transition-colors py-2 border-b border-white/5 flex items-center justify-between">
        Claude <span class="w-2 h-2 rounded-full bg-orange-400"></span>
      </a>
      <a href="#opencode" class="hover:text-indigo-400 transition-colors py-2 border-b border-white/5 flex items-center justify-between">
        OpenCode <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
      </a>
      <a href="#compromiso" class="hover:text-amber-400 transition-colors py-2 border-b border-white/5 flex items-center justify-between">
        Nuestro Compromiso <span class="w-2 h-2 rounded-full bg-amber-400"></span>
      </a>
      <a href="#contacto" class="hover:text-purple-400 transition-colors py-2 border-b border-white/5 flex items-center justify-between">
        Contacto <span class="w-2 h-2 rounded-full bg-purple-400"></span>
      </a>
    </nav>

    <!-- Support details in mobile menu -->
    <div class="mt-auto border-t border-white/5 pt-6 space-y-4 text-xs text-slate-400 font-sans">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#6d1e68]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>Avellaneda No. 260, Camagüey</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-green-400" fill="currentColor" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.197 1.48 4.887 1.48 5.482 0 9.944-4.461 9.947-9.948.002-2.659-1.03-5.158-2.905-7.037C16.699 1.77 14.2 .73 11.545.728 6.062.728 1.6 5.189 1.597 10.677c-.001 1.77.476 3.498 1.38 5.03l-.995 3.637 3.733-.979.332.197zm11.386-7.854c-.302-.15-1.785-.882-2.062-.982-.277-.1-.478-.15-.679.15-.201.3-.778.982-.954 1.183-.176.2-.352.225-.654.075-.302-.15-1.276-.47-2.43-1.499-.898-.8-1.503-1.79-1.679-2.09-.176-.3-.019-.462.131-.611.135-.134.302-.35.453-.524.151-.175.201-.3.302-.5.101-.2.05-.375-.025-.526-.075-.15-.679-1.636-.93-2.24-.244-.587-.493-.507-.679-.516-.176-.008-.377-.01-.578-.01-.201 0-.527.075-.803.375-.276.3-1.055 1.03-1.055 2.512s1.08 2.922 1.23 3.122c.15.2 2.127 3.248 5.153 4.553.72.31 1.282.495 1.72.634.724.23 1.381.198 1.901.12.58-.087 1.785-.73 2.037-1.435.252-.705.252-1.31.176-1.435-.076-.125-.277-.2-5.78-.35z"/>
        </svg>
        <span>(+53) 5359253999</span>
      </div>
      <a 
        href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola! No estoy seguro de qué plan de IA se adapta mejor a mis necesidades. ¿Podrían ayudarme a elegir el ideal para mi caso y consultar los precios?')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="block text-center py-2.5 px-4 rounded-xl bg-gradient-to-r from-amber-400 via-yellow-500 to-amber-600 hover:from-amber-500 hover:to-yellow-600 text-slate-950 font-black tracking-wide"
      >
        Consulta qué plan es mejor para ti
      </a>
    </div>
  </div>

  <!-- Hero Section -->
  <section id="hero" class="max-w-4xl mx-auto text-center px-6 pt-24 pb-20 relative">
    <!-- Premium background glowing tech orb -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[350px] md:w-[600px] md:h-[600px] rounded-full bg-gradient-to-tr from-purple-600/10 via-[#6d1e68]/5 to-indigo-500/10 blur-[130px] pointer-events-none -z-10 animate-pulse" style="animation-duration: 7s;"></div>

    <!-- Large Logo in Hero -->
    <div class="flex justify-center -my-8 md:-my-12 mb-4 md:mb-6 scroll-reveal reveal-up">
      <img src="/logo-en-blanco.png" alt="Carmay Outfit Logo" class="w-64 md:w-80 h-auto object-contain" />
    </div>
    
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-white mb-6 font-display leading-[1.15] scroll-reveal reveal-up">
      Accede a las herramientas <br/>
      <span class="bg-gradient-to-r from-purple-400 via-indigo-300 to-blue-400 bg-clip-text text-transparent">
        de IA más potentes del mundo
      </span>
    </h1>
    
    <p class="text-base md:text-lg text-slate-300 max-w-2.5xl mx-auto mb-10 leading-relaxed scroll-reveal reveal-up font-sans">
      Queremos que cualquier persona en Cuba pueda utilizar y aprovechar los modelos de IA más avanzados, como ChatGPT, Claude o Gemini. Ya seas estudiante, trabajador o programador, integrar la IA en tu día a día aumentará tu productividad y te dará acceso inmediato a la tecnología que está transformando el mundo. Te ofrecemos suscripciones oficiales con pago local. <strong>Si no estás seguro de cuál elegir, consúltanos directamente y te recomendaremos la mejor opción para tu caso.</strong>
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center scroll-reveal reveal-up">
      <!-- Golden CTA Button -->
      <a 
        href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola! No estoy seguro de qué plan de IA me conviene contratar según mi perfil y necesidades. ¿Me podrían ayudar a elegir el plan ideal para mi caso?')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-gradient-to-r from-amber-400 via-yellow-500 to-amber-600 hover:from-amber-500 hover:to-yellow-600 text-slate-950 font-bold shadow-lg shadow-amber-500/20 transition-all hover:-translate-y-0.5 active:translate-y-0 text-center border border-yellow-300/30 flex items-center justify-center gap-2"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        Consulta qué plan es mejor para ti
      </a>
    </div>
  </section>

  <!-- ¿Cómo te ayuda la IA? Section -->
  <section class="max-w-6xl mx-auto px-6 py-12 mb-16 scroll-reveal reveal-up">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-white font-display mb-3">
        ¿Cómo puede ayudarte la Inteligencia Artificial?
      </h2>
      <p class="text-sm text-slate-400 font-sans">
        Una herramienta multiuso que se adapta a cualquier necesidad para multiplicar tus resultados.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Card 1: Creación de Contenido -->
      <div class="p-5 rounded-2xl bg-slate-950/30 border border-white/5 hover:border-pink-500/20 shadow-md shadow-pink-950/5 transition-all duration-300 group">
        <div class="w-10 h-10 rounded-xl bg-pink-500/10 border border-pink-500/25 flex items-center justify-center text-pink-400 mb-4 group-hover:bg-pink-500/20 transition-all duration-300">
          <!-- Sparkles Icon -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
            <path d="m5 3 1 2.5L8.5 6 6 7 5 9.5 4 7 1.5 6 4 5.5z"/>
            <path d="m19 17 1 2.5 2.5.5-2.5 1-1 2.5-1-2.5-2.5-1 2.5-1z"/>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-white mb-2 font-display">Creación de Contenido</h3>
        <p class="text-xs text-slate-400 leading-relaxed font-sans">Genera ideas de marketing efectivas, redacta guiones persuasivos y diseña pósteres, anuncios e imágenes de alta claridad limitadas únicamente por tu imaginación.</p>
      </div>

      <!-- Card 2: Programación y Desarrollo -->
      <div class="p-5 rounded-2xl bg-slate-950/30 border border-white/5 hover:border-blue-500/20 shadow-md shadow-blue-950/5 transition-all duration-300 group">
        <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/25 flex items-center justify-center text-blue-400 mb-4 group-hover:bg-blue-500/20 transition-all duration-300">
          <!-- Code Icon -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <polyline points="16 18 22 12 16 6"/>
            <polyline points="8 6 2 12 8 18"/>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-white mb-2 font-display">Programación y Desarrollo</h3>
        <p class="text-xs text-slate-400 leading-relaxed font-sans">Aumenta exponencialmente tu productividad con modelos frontera de Anthropic (el rey indiscutible en desarrollo de software) y accede a Claude Code, la herramienta de programación más utilizada por programadores en todo el mundo.</p>
      </div>

      <!-- Card 3: Análisis y Estrategia de Negocio -->
      <div class="p-5 rounded-2xl bg-slate-950/30 border border-white/5 hover:border-amber-500/20 shadow-md shadow-amber-950/5 transition-all duration-300 group">
        <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/25 flex items-center justify-center text-amber-400 mb-4 group-hover:bg-amber-500/20 transition-all duration-300">
          <!-- LineChart Icon -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M3 3v18h18"/>
            <path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-white mb-2 font-display">Análisis y Estrategia de Negocio</h3>
        <p class="text-xs text-slate-400 leading-relaxed font-sans">Fusiona el análisis de información clave de tu negocio con planificación estratégica. Analiza documentos extensos en PDF para guiarte en el diseño de las mejores estrategias comerciales.</p>
      </div>

      <!-- Card 4: Emprendimiento y Crecimiento -->
      <div class="p-5 rounded-2xl bg-slate-950/30 border border-white/5 hover:border-emerald-500/20 shadow-md shadow-emerald-950/5 transition-all duration-300 group">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/25 flex items-center justify-center text-emerald-400 mb-4 group-hover:bg-emerald-500/20 transition-all duration-300">
          <!-- Briefcase Icon -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-white mb-2 font-display">Emprendimiento y Nuevos Negocios</h3>
        <p class="text-xs text-slate-400 leading-relaxed font-sans">Ideal para pequeños negocios y startups. Aumenta tus conocimientos, obtén visiones innovadoras, gestiona finanzas y recursos humanos, y potencia el rendimiento de tus empleados con IA.</p>
      </div>

      <!-- Card 5: Estudios y Aprendizaje -->
      <div class="p-5 rounded-2xl bg-slate-950/30 border border-white/5 hover:border-purple-500/20 shadow-md shadow-purple-950/5 transition-all duration-300 group">
        <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/25 flex items-center justify-center text-purple-400 mb-4 group-hover:bg-purple-500/20 transition-all duration-300">
          <!-- Graduation Cap Icon -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
            <path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"/>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-white mb-2 font-display">Estudios y Aprendizaje</h3>
        <p class="text-xs text-slate-400 leading-relaxed font-sans">Explica conceptos difíciles de forma sencilla, traduce idiomas al instante y te da acceso a búsquedas avanzadas (Deep Research) para realizar cualquier tipo de investigación con máximo rigor.</p>
      </div>

      <!-- Card 6: Agente y Asesor Personal -->
      <div class="p-5 rounded-2xl bg-slate-950/30 border border-white/5 hover:border-orange-500/20 shadow-md shadow-orange-950/5 transition-all duration-300 group">
        <div class="w-10 h-10 rounded-xl bg-orange-500/10 border border-orange-500/25 flex items-center justify-center text-orange-400 mb-4 group-hover:bg-orange-500/20 transition-all duration-300">
          <!-- Robot Assistant Icon -->
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 8V4H8"/>
            <rect width="16" height="12" x="4" y="8" rx="2"/>
            <path d="M2 14h2"/>
            <path d="M20 14h2"/>
            <path d="M15 13v2"/>
            <path d="M9 13v2"/>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-white mb-2 font-display">Agente y Asesor Personal</h3>
        <p class="text-xs text-slate-400 leading-relaxed font-sans">Tu asistente personalizado con acceso a internet en tiempo real para ayudarte en cualquier tarea, resolver dudas de inmediato y gestionar tu día a día de forma inteligente.</p>
      </div>
    </div>
  </section>

  <!-- 1. OPENAI SECTION -->
  <section id="openai" class="relative max-w-6xl mx-auto px-6 py-24 scroll-mt-24 overflow-hidden rounded-3xl bg-slate-950/40 border-2 border-slate-800/80 section-openai mb-20">
    <!-- Top-centered radial glow -->
    <div class="absolute inset-0 pointer-events-none -z-20 bg-gradient-to-b from-emerald-950/20 via-transparent to-transparent"></div>
    
    <!-- Giant Watermark Logo with backing glow -->
    <div class="absolute right-[-10%] top-[-5%] text-emerald-400 pointer-events-none -z-10 w-[350px] h-[350px] md:w-[600px] md:h-[600px] brand-watermark flex items-center justify-center">
      <div class="w-full h-full animate-spin-slow flex items-center justify-center relative">
