  <!-- JS for Dynamic background color shift, scroll-driven reveals, and scroll spy navigation -->
  <script>
    const dynamicBg = document.getElementById('dynamic-bg');
    const scrollProgress = document.getElementById('scroll-progress');
    const sections = document.querySelectorAll('section[id]');
    const scrollRevealElements = document.querySelectorAll('.scroll-reveal');

    // Navigation scroll spy links mapping
    const navLinksMap = {
      openai: { el: document.getElementById('nav-link-openai'), activeClass: 'text-emerald-400' },
      google: { el: document.getElementById('nav-link-google'), activeClass: 'text-blue-400' },
      anthropic: { el: document.getElementById('nav-link-anthropic'), activeClass: 'text-orange-400' },
      opencode: { el: document.getElementById('nav-link-opencode'), activeClass: 'text-indigo-400' },
      compromiso: { el: document.getElementById('nav-link-compromiso'), activeClass: 'text-amber-400' },
      contacto: { el: document.getElementById('nav-link-contacto'), activeClass: 'text-purple-400' }
    };

    const bgMap = {
      openai: 'bg-[#021812]',       // More saturated deep forest emerald
      google: 'bg-[#031435]',       // More saturated deep tech space blue
      anthropic: 'bg-[#1a0e07]',    // More saturated deep warm copper clay
      opencode: 'bg-[#08071a]',     // Deep violet/indigo coding space
      compromiso: 'bg-[#100615]',   // More saturated deep purple
      contacto: 'bg-[#0a0710]',     // Rich dark slate for contact section
      'como-funciona': 'bg-[#07090e]'
    };

    const observerOptions = {
      root: null,
      rootMargin: '-30% 0px -40% 0px', // Actives when section hits the center of screen
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          
          // Toggle active-section class for themed styling (glow + watermark highlight)
          sections.forEach(s => s.classList.remove('active-section'));
          entry.target.classList.add('active-section');

          if (bgMap[id]) {
            dynamicBg.className = 'fixed inset-0 -z-20 bg-transition ' + bgMap[id];
          } else {
            dynamicBg.className = 'fixed inset-0 -z-20 bg-transition bg-[#090b11]';
          }

          // Update navigation Scroll Spy highlighting
          Object.values(navLinksMap).forEach(({ el, activeClass }) => {
            if (el) {
              el.classList.remove(activeClass, 'text-white');
              el.classList.add('text-slate-300');
            }
          });
          if (navLinksMap[id]) {
            const { el, activeClass } = navLinksMap[id];
            if (el) {
              el.classList.remove('text-slate-300');
              el.classList.add(activeClass, 'text-white');
            }
          }
        }
      });
    }, observerOptions);

    sections.forEach(section => observer.observe(section));

    // Scroll reveal and progress logic (entry and exit upwards transitions)
    function checkScroll() {
      const viewportHeight = window.innerHeight;
      
      // Update reading progress bar width
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / (height || 1)) * 100;
      if (scrollProgress) {
        scrollProgress.style.width = scrolled + '%';
      }

      // Check reveal bounds
      scrollRevealElements.forEach(el => {
        const rect = el.getBoundingClientRect();
        
        // Element is scrolled past the top (exit upwards)
        if (rect.bottom < 120) {
          el.classList.remove('visible');
          el.classList.add('scrolled-up');
        } 
        // Element is visible in the viewport
        else if (rect.top <= viewportHeight - 65) {
          el.classList.add('visible');
          el.classList.remove('scrolled-up');
        } 
        // Element is below the viewport
        else {
          el.classList.remove('visible', 'scrolled-up');
        }
      });
    }

    // Bind scroll and resize listeners
    window.addEventListener('scroll', checkScroll, { passive: true });
    window.addEventListener('resize', checkScroll, { passive: true });
    
    // Initial runs to trigger visible states on load
    checkScroll();
    setTimeout(checkScroll, 100);
    setTimeout(checkScroll, 400);

    // Mobile menu toggling logic
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
    const mobileMenuDrawer = document.getElementById('mobile-menu-drawer');
    const mobileLinks = mobileMenuDrawer ? mobileMenuDrawer.querySelectorAll('a') : [];

    let isMenuOpen = false;

    function toggleMenu() {
      isMenuOpen = !isMenuOpen;
      if (isMenuOpen) {
        mobileMenuOverlay.classList.remove('pointer-events-none', 'opacity-0');
        mobileMenuOverlay.classList.add('opacity-100');
        mobileMenuDrawer.classList.remove('translate-x-full');
      } else {
        mobileMenuOverlay.classList.remove('opacity-100');
        mobileMenuOverlay.classList.add('opacity-0', 'pointer-events-none');
        mobileMenuDrawer.classList.add('translate-x-full');
      }
    }

    if (mobileMenuBtn && mobileMenuClose && mobileMenuOverlay && mobileMenuDrawer) {
      mobileMenuBtn.addEventListener('click', toggleMenu);
      mobileMenuClose.addEventListener('click', toggleMenu);
      mobileMenuOverlay.addEventListener('click', toggleMenu);
    }

    // Close menu when a link is clicked
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (isMenuOpen) toggleMenu();
      });
    });

    // Reactivity for Month Selectors (updates prices & WhatsApp link)
    const monthSelectors = document.querySelectorAll('.month-selector');
    const btnMinusList = document.querySelectorAll('.btn-minus');
    const btnPlusList = document.querySelectorAll('.btn-plus');
    const WHATSAPP_NUMBER_VAL = "5359253999";

    function formatCurrency(price) {
      return price.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    }

    monthSelectors.forEach(selector => {
      const handleInput = (e) => {
        let val = parseInt(e.target.value);
        const planId = e.target.getAttribute('data-plan-id');
        
        // Prevent 0 or negative values in the input field itself
        if (!isNaN(val) && val <= 0) {
          e.target.value = 1;
          val = 1;
        }
        
        if (isNaN(val) || val < 1) {
          val = 1;
        }
        const planName = e.target.getAttribute('data-plan-name');
        const planProvider = e.target.getAttribute('data-plan-provider');
        const baseUSD = parseFloat(e.target.getAttribute('data-price-usd'));
        const baseCUP = parseFloat(e.target.getAttribute('data-price-cup'));

        const totalUSD = baseUSD * val;
        const totalCUP = baseCUP * val;

        // Find displays in DOM
        const usdDisplay = document.querySelector(`.usd-price-display[data-plan-id="${planId}"]`);
        const cupDisplay = document.querySelector(`.cup-price-display[data-plan-id="${planId}"]`);
        const durationDisplay = document.querySelector(`.duration-display[data-plan-id="${planId}"]`);

        // Update display text values
        if (usdDisplay) usdDisplay.textContent = totalUSD.toFixed(2);
        if (cupDisplay) cupDisplay.textContent = formatCurrency(totalCUP);
        if (durationDisplay) {
          durationDisplay.textContent = planId === 'opencode-zen' ? 'CRÉDITO A RECARGAR' : (val === 1 ? 'SUSCRIPCIÓN MENSUAL' : `CONTRATO POR ${val} MESES`);
        }

        // Update WhatsApp message link
        const text = planId === 'opencode-zen'
          ? `Hola! Estoy interesado en adquirir *Crédito de ${planName}* (${planProvider}) por un monto de *${val} USD* de saldo, por un valor de pago de *${totalUSD.toFixed(2)} USD* (${formatCurrency(totalCUP)} CUP). ¿Cómo podemos coordinar el pago?`
          : `Hola! Estoy interesado en adquirir la *Suscripción de ${planName}* (${planProvider}) por *${val} ${val === 1 ? 'mes' : 'meses'}* por un valor total de *${totalUSD.toFixed(2)} USD* (${formatCurrency(totalCUP)} CUP). ¿Cómo podemos coordinar el pago?`;
        const waBtn = document.querySelector(`.whatsapp-btn[data-plan-id="${planId}"]`);
        if (waBtn) {
          waBtn.setAttribute('href', `https://wa.me/${WHATSAPP_NUMBER_VAL}?text=${encodeURIComponent(text)}`);
        }
      };

      selector.addEventListener('input', handleInput);
      selector.addEventListener('change', (e) => {
        const planId = e.target.getAttribute('data-plan-id');
        const minVal = planId === 'opencode-zen' ? 10 : 1;
        if (parseInt(e.target.value) < minVal || isNaN(parseInt(e.target.value))) {
          e.target.value = minVal;
          handleInput(e);
        }
      });
    });

    // Plus / Minus Button click events
    btnMinusList.forEach(btn => {
      btn.addEventListener('click', () => {
        const planId = btn.getAttribute('data-plan-id');
        const input = document.querySelector(`.month-selector[data-plan-id="${planId}"]`);
        if (input) {
          let val = parseInt(input.value) || 1;
          const min = planId === 'opencode-zen' ? 10 : 1;
          const step = 1;
          if (val > min) {
            input.value = val - step;
            input.dispatchEvent(new Event('input'));
          }
        }
      });
    });

    btnPlusList.forEach(btn => {
      btn.addEventListener('click', () => {
        const planId = btn.getAttribute('data-plan-id');
        const input = document.querySelector(`.month-selector[data-plan-id="${planId}"]`);
        if (input) {
          let val = parseInt(input.value) || 1;
          const max = planId === 'opencode-zen' ? 500 : 36;
          const step = 1;
          if (val < max) {
            input.value = val + step;
            input.dispatchEvent(new Event('input'));
          }
        }
      });
    });
  </script>
</Layout>
